---
import BaseLayout from "../layouts/BaseLayout.astro";

const features = [
  ["Monthly budgets", "Use your yearly plan as the starting point for each month and adjust as needed."],
  ["Accounts", "Track your balances and check them against your bank statements."],
  ["Transactions", "Categorize transactions, split purchases, and save templates for splits you use often."],
  ["Reports", "See your net worth, spending by category, and amounts carried forward each month."],
  ["Yearly plan", "Set up your categories and budget targets to use throughout the year."],
  ["Optional integrations", "Import transactions with Plaid and Venmo, add Amazon order details, and use AI to suggest categories."],
];

const steps = [
  ["01", "Make a plan", "Set up your yearly plan with categories for what you earn and what you plan to spend."],
  ["02", "Track your transactions", "Enter transactions yourself or use optional integrations to import them."],
  ["03", "Review your month", "Check your account balances and see how your spending compares to your plan."],
];
---

<BaseLayout
  description="Budgeted is a modern, self-hosted, open-source and personal budgeting app."
  current="home"
>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">A modern budgeting app for you and your family</p>
        <h1>Plan yearly and think monthly.</h1>
        <p class="lede">Budgeted is based on a yearly plan with a monthly view of how well that plan is going.</p>
        <div class="hero-actions">
          <a class="button primary" href="/docs/getting-started/">Get Budgeted <span aria-hidden="true">→</span></a>
          <a class="button secondary" href="https://github.com/budgetedhq/budgeted">View on GitHub <span aria-hidden="true">↗</span></a>
        </div>
        <p class="hero-note"><span aria-hidden="true">◆</span> Budgeted is open source. Hosted in your AWS account.</p>
      </div>
      <div class="hero-visual" aria-label="Budgeted monthly budget screenshot">
        <div class="visual-label"><span>Monthly budget</span><span>Actual Budgeted interface</span></div>
        <img src="/images/monthly-budget.webp" width="1440" height="900" alt="Budgeted monthly budget showing fictional income and spending categories" />
      </div>
    </div>
  </section>

  <section class="principle-band" aria-label="Budgeting principle">
    <div class="shell principle-grid">
      <p class="eyebrow">Budgeted in a nutshell</p>
      <div><span>Accounts</span><strong>show where your money is.</strong></div>
      <div><span>Categories</span><strong>show what your money is for.</strong></div>
    </div>
  </section>

  <section class="section" id="how-it-works">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">How it works</p><h2>Plan and track.</h2></div>
        <p>Plan your monthly budget and categorize transactions to see how it is going.</p>
      </div>
      <ol class="steps">
        {steps.map(([number, title, description]) => (
          <li><span>{number}</span><h3>{title}</h3><p>{description}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section product-story" aria-label="Budgeted product views">
    <div class="shell story-grid">
      <div class="story-copy">
        <p class="eyebrow">Transactions</p>
        <h2>Track what comes in and what goes out.</h2>
        <p>Record income, purchases, and transfers between accounts. Split a purchase across categories when you need to.</p>
        <ul><li>Account and category views</li><li>Reusable split templates</li><li>Cleared and reconciled transactions</li></ul>
      </div>
      <figure class="product-frame">
        <img loading="lazy" src="/images/transactions.webp" width="1440" height="900" alt="Budgeted transaction table filled with fictional household purchases" />
        <figcaption>Transactions</figcaption>
      </figure>
    </div>
  </section>

  <section class="section product-story alternate">
    <div class="shell story-grid">
      <figure class="product-frame">
        <img loading="lazy" src="/images/reporting.webp" width="1440" height="900" alt="Budgeted reporting dashboard showing fictional category activity and balances" />
        <figcaption>Reporting</figcaption>
      </figure>
      <div class="story-copy">
        <p class="eyebrow">Reports</p>
        <h2>See how your plan is going.</h2>
        <p>See your account balances, net worth, and spending by category. Compare months to see what has changed.</p>
        <ul><li>Net worth and account balances</li><li>Category spending and activity</li><li>Amounts carried forward each month</li></ul>
      </div>
    </div>
  </section>

  <section class="section" id="features">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">Features</p><h2>Plan, track, and review.</h2></div>
        <p>Manage your budget, accounts, and transactions in one place. Use optional integrations to save time.</p>
      </div>
      <div class="feature-grid">
        {features.map(([title, description], index) => (
          <article><span>{String(index + 1).padStart(2, "0")}</span><h3>{title}</h3><p>{description}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section ownership-section">
    <div class="shell ownership-grid">
      <div><p class="eyebrow">Get Budgeted</p><h2>Your budget. Your data.</h2></div>
      <div><p>Budgeted is open source and hosted in your AWS account. A setup guide for installing it with Budgeted Launcher is coming soon.</p><a class="text-link" href="/docs/getting-started/">Getting started <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="final-cta">
    <div class="shell cta-inner">
      <div><p class="eyebrow">Start planning</p><h2>Make a plan for your money.</h2></div>
      <a class="button primary" href="/docs/getting-started/">Get Budgeted <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
