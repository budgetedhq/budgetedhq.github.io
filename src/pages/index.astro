---
import BaseLayout from "../layouts/BaseLayout.astro";

const features = [
  ["Monthly budgets", "Plan one month at a time while keeping your reusable budget structure close at hand."],
  ["Accounts that reconcile", "Track opening balances, cleared activity, and the numbers you expect to see at the bank."],
  ["Detailed transactions", "Split purchases, save reusable templates, and keep every movement balanced in the ledger."],
  ["Reports with context", "See net worth, category activity, spending, and carry-forward changes without losing the trail."],
  ["A reusable budget plan", "Set up categories and targets once, then make intentional adjustments for each month."],
  ["Optional automation", "Bring in Plaid, Venmo, Amazon order details, and AI-assisted classification when they help."],
];

const steps = [
  ["01", "Plan with purpose", "Give the money you have a job using categories that match your real priorities."],
  ["02", "Keep activity current", "Enter transactions yourself or use optional integrations to reduce routine work."],
  ["03", "Review with confidence", "Reconcile accounts, inspect reports, and carry the right context into next month."],
];
---

<BaseLayout
  description="Budgeted is a personal budgeting app that connects monthly planning, everyday transactions, account reconciliation, and reporting through a balanced ledger."
  current="home"
>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Personal budgeting, clearly accounted for</p>
        <h1>Know what your money is for—and where it really is.</h1>
        <p class="lede">Budgeted connects your monthly plan, transactions, account balances, and reports through one balanced ledger.</p>
        <div class="hero-actions">
          <a class="button primary" href="/docs/getting-started/">Get Budgeted <span aria-hidden="true">→</span></a>
          <a class="button secondary" href="https://github.com/budgetedhq/budgeted">View on GitHub <span aria-hidden="true">↗</span></a>
        </div>
        <p class="hero-note"><span aria-hidden="true">◆</span> Open source. Hosted in your AWS account.</p>
      </div>
      <div class="hero-visual" aria-label="Budgeted monthly budget screenshot">
        <div class="visual-label"><span>Monthly budget</span><span>Actual Budgeted interface</span></div>
        <img src="/images/monthly-budget.webp" width="1440" height="900" alt="Budgeted monthly budget showing fictional income and spending categories" />
      </div>
    </div>
  </section>

  <section class="principle-band" aria-label="Budgeting principle">
    <div class="shell principle-grid">
      <p class="eyebrow">One simple distinction</p>
      <div><span>Accounts</span><strong>show where your money is.</strong></div>
      <div><span>Categories</span><strong>show what your money is for.</strong></div>
    </div>
  </section>

  <section class="section" id="how-it-works">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">How it works</p><h2>A clear rhythm for your money.</h2></div>
        <p>Budgeted follows the way budgeting actually happens: decide, record, review, repeat.</p>
      </div>
      <ol class="steps">
        {steps.map(([number, title, description]) => (
          <li><span>{number}</span><h3>{title}</h3><p>{description}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section product-story" aria-label="Budgeted product views">
    <div class="shell story-grid">
      <div class="story-copy">
        <p class="eyebrow">Everyday clarity</p>
        <h2>Transactions keep the story honest.</h2>
        <p>Record purchases, transfers, income, and split activity without separating budgeting from the ledger underneath it.</p>
        <ul><li>Account and category views</li><li>Reusable split templates</li><li>Cleared and reconciled states</li></ul>
      </div>
      <figure class="product-frame">
        <img loading="lazy" src="/images/transactions.webp" width="1440" height="900" alt="Budgeted transaction table filled with fictional household purchases" />
        <figcaption>Transactions</figcaption>
      </figure>
    </div>
  </section>

  <section class="section product-story alternate">
    <div class="shell story-grid">
      <figure class="product-frame">
        <img loading="lazy" src="/images/reporting.webp" width="1440" height="900" alt="Budgeted reporting dashboard showing fictional category activity and balances" />
        <figcaption>Reporting</figcaption>
      </figure>
      <div class="story-copy">
        <p class="eyebrow">Useful perspective</p>
        <h2>See the month—and the trail behind it.</h2>
        <p>Move from the big picture into category detail while the ledger remains the source of truth for balances and activity.</p>
        <ul><li>Net worth and account balances</li><li>Category spending and activity</li><li>Month-to-month carry-forward context</li></ul>
      </div>
    </div>
  </section>

  <section class="section" id="features">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">Features</p><h2>Built for the whole budgeting loop.</h2></div>
        <p>Enough structure to keep the numbers reliable, with optional automation where it saves time.</p>
      </div>
      <div class="feature-grid">
        {features.map(([title, description], index) => (
          <article><span>{String(index + 1).padStart(2, "0")}</span><h3>{title}</h3><p>{description}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section ownership-section">
    <div class="shell ownership-grid">
      <div><p class="eyebrow">Your installation</p><h2>Open source, in an AWS account you control.</h2></div>
      <div><p>Budgeted is software you host rather than another budgeting subscription. The upcoming setup guide will walk through installing it with Budgeted Launcher.</p><a class="text-link" href="/docs/getting-started/">See getting started <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="final-cta">
    <div class="shell cta-inner">
      <div><p class="eyebrow">Ready when the guide is</p><h2>Make every dollar easier to explain.</h2></div>
      <a class="button primary" href="/docs/getting-started/">Get Budgeted <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
