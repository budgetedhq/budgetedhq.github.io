---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="We couldn’t find this Budgeted page.">
  <section class="not-found">
    <div class="shell narrow-shell">
      <p class="error-code">404</p>
      <p class="eyebrow">Page not found</p>
      <h1>We couldn’t find this page.</h1>
      <p class="lede">The address may have changed, or the page may not exist yet.</p>
      <div class="hero-actions"><a class="button primary" href="/">Return home</a><a class="button secondary" href="/docs/">Browse documentation</a></div>
    </div>
  </section>
</BaseLayout>
